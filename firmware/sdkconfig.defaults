# ESP-IDF v6.x target: esp32s31
CONFIG_IDF_TARGET="esp32s31"

# Flash & PSRAM (Mosaico: 16MB NOR, 16MB octal PSRAM in-package)
# 官方 esp-mosaico-bsp 所有示例统一使用 250MHz（esp32s31 可选 250/200/100/40）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Serial console via USB Serial/JTAG (Mosaico 只用 USB 口)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_USB_SERIAL_JTAG=y

# LVGL needs enough heap
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable log colors for readability
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# I2C driver
CONFIG_SOC_I2C_SUPPORT_MULTI=y

# Partition table: app 4MB（LVGL + 中文子集字库）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL 中文（16px 思源黑体，界面标签/气泡使用）
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y

